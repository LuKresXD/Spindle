# The MAFNKOU 13.3" touch panel (wch.cn controller) exposes a second, mouse-emulation
# interface next to its touch interface. libinput treats it as a pointer, so the
# compositor draws a cursor on the OLED. Hide that interface from libinput.
# Install: sudo cp spindle-touch.rules /etc/udev/rules.d/98-spindle-touch.rules
#          sudo udevadm control --reload && sudo udevadm trigger --subsystem-match=input
ACTION=="add|change", SUBSYSTEM=="input", KERNEL=="event*", ATTRS{name}=="wch.cn TouchScreen", ENV{ID_INPUT_MOUSE}=="1", ENV{ID_INPUT_TOUCHSCREEN}!="1", ENV{LIBINPUT_IGNORE_DEVICE}="1"
