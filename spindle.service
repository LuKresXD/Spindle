[Unit]
Description=Spindle — vinyl scrobbler
After=network-online.target sound.target
Wants=network-online.target

[Service]
Type=simple
User=luka
Group=luka
WorkingDirectory=/home/luka/spindle
ExecStart=/home/luka/spindle/venv/bin/spindle
Restart=on-failure
RestartSec=5
# SIGTERM goes to spindle only; it stops its own arecord (otherwise the capture
# thread sees arecord die first and logs a spurious restart warning).
KillMode=mixed
StandardOutput=journal
StandardError=journal

# Env
Environment=HOME=/home/luka

[Install]
WantedBy=multi-user.target
